<Window x:Class="CyberSafeAwarenessBot2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberSafe Awareness Bot"
        Height="700"
        Width="900"
        MinHeight="550"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Border Margin="12"
            Padding="12"
            BorderBrush="#F97316"
            BorderThickness="2"
            CornerRadius="12"
            Background="#FFFDFC">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Application Header -->
            <Border Grid.Row="0"
                    Background="#B9380A"
                    CornerRadius="9"
                    Padding="16"
                    Margin="0,0,0,12">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="7"
                            Padding="10"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">

                        <Image Source="/CyberSafeAwarenessBot2;component/CyberSafeASCII.png"
                               Width="64"
                               Height="64"
                               Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <TextBlock Text="CYBERSAFE AWARENESS BOT"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Your guide to staying safe online"
                                   FontSize="14"
                                   Foreground="#FFE4D6"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="Ask questions. Learn the risks. Stay protected."
                                   FontSize="12"
                                   Foreground="White"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Navigation -->
            <TabControl Grid.Row="1"
                        FontSize="14"
                        Background="White"
                        BorderBrush="#FED7AA"
                        BorderThickness="1">

                <!-- CHAT TAB -->
                <TabItem Header="Chat">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="White"
                                BorderBrush="#FED7AA"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,12">

                            <TextBox x:Name="ChatHistory"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     BorderThickness="0"
                                     Background="White"
                                     Foreground="#334155"
                                     FontSize="14"
                                     FontFamily="Segoe UI"
                                     IsTabStop="False"
                                     Text="Bot: Welcome to CyberSafe Awareness Bot!&#10;Bot: Ask me about passwords, phishing, scams, or online privacy."/>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="UserInput"
                                     Grid.Column="0"
                                     MinHeight="42"
                                     Padding="10"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#94A3B8"
                                     BorderThickness="1"
                                     Margin="0,0,10,0"
                                     ToolTip="Type your cybersecurity question"/>

                            <Button x:Name="SendButton"
                                    Grid.Column="1"
                                    Content="Send"
                                    Width="100"
                                    MinHeight="42"
                                    Padding="12,8"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Background="#F97316"
                                    BorderBrush="#C2410C"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="SendButton_Click"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TASK ASSISTANT TAB -->
                <TabItem Header="Tasks">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Cybersecurity Task Assistant"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#B9380A"
                                   Margin="0,0,0,15"/>

                        <StackPanel Grid.Row="1"
                                    Margin="0,0,0,15">

                            <TextBlock Text="Task title"/>
                            <TextBox x:Name="TaskTitleInput"
                                     Height="30"
                                     Margin="0,5,0,10"/>

                            <TextBlock Text="Description"/>
                            <TextBox x:Name="TaskDescriptionInput"
                                     Height="55"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Margin="0,5,0,10"/>

                            <TextBlock Text="Optional reminder"/>
                            <DatePicker x:Name="TaskReminderInput"
                                        Margin="0,5,0,10"/>

                            <Button Content="Add Task"
                                    Width="110"
                                    Height="32"
                                    HorizontalAlignment="Left"
                                    Click="AddTask_Click"/>
                        </StackPanel>

                        <DataGrid x:Name="TasksGrid"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Margin="0,5">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding TaskId}"/>

                                <DataGridTextColumn Header="Title"
                                                    Binding="{Binding Title}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Description"
                                                    Binding="{Binding Description}"
                                                    Width="2*"/>

                                <DataGridTextColumn Header="Reminder"
                                                    Binding="{Binding ReminderDate}"/>

                                <DataGridCheckBoxColumn Header="Completed"
                                                        Binding="{Binding IsCompleted}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0">

                            <Button Content="Refresh"
                                    Width="85"
                                    Margin="5"
                                    Click="RefreshTasks_Click"/>

                            <Button Content="Complete"
                                    Width="85"
                                    Margin="5"
                                    Click="CompleteTask_Click"/>

                            <Button Content="Delete"
                                    Width="85"
                                    Margin="5"
                                    Click="DeleteTask_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- CYBER QUIZ TAB -->
                <TabItem Header="Cyber Quiz">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Cybersecurity Knowledge Quiz"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#B9380A"/>

                            <TextBlock x:Name="QuizProgressText"
                                       Text="Question 1 of 12"
                                       FontSize="14"
                                       Foreground="#64748B"
                                       Margin="0,8,0,15"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="#FFF7ED"
                                BorderBrush="#FED7AA"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,15">

                            <TextBlock x:Name="QuizQuestionText"
                                       Text="Your question will appear here."
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="#334155"/>
                        </Border>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto">

                            <StackPanel x:Name="QuizOptionsPanel"
                                        Margin="5"/>
                        </ScrollViewer>

                        <Border Grid.Row="3"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,10,0,10">

                            <TextBlock x:Name="QuizFeedbackText"
                                       Text="Select an answer and submit."
                                       TextWrapping="Wrap"
                                       Foreground="#334155"
                                       FontSize="14"/>
                        </Border>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="QuizScoreText"
                                       Grid.Column="0"
                                       Text="Score: 0"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="#B9380A"/>

                            <Button x:Name="SubmitAnswerButton"
                                    Grid.Column="1"
                                    Content="Submit Answer"
                                    Padding="15,8"
                                    Margin="5"
                                    Background="#F97316"
                                    Foreground="White"
                                    Click="SubmitAnswer_Click"/>

                            <Button x:Name="NextQuestionButton"
                                    Grid.Column="2"
                                    Content="Next"
                                    Padding="15,8"
                                    Margin="5"
                                    IsEnabled="False"
                                    Click="NextQuestion_Click"/>
                        </Grid>

                    </Grid>
                </TabItem>

                <!-- ACTIVITY LOG TAB -->
                <TabItem Header="Activity Log">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Recent Activity"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#B9380A"/>

                            <TextBlock Text="Your recent chatbot and task activities."
                                       Margin="0,8,0,15"
                                       Foreground="#64748B"/>
                        </StackPanel>

                        <ListBox x:Name="ActivityLogList"
                                 Grid.Row="1"
                                 FontSize="14"
                                 Padding="8"
                                 BorderBrush="#FED7AA"
                                 Background="White"/>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</Window>
