<Window x:Class="CyberSafeAwarenessBot2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberSafe Awareness Bot"
        Height="700"
        Width="900"
        MinHeight="550"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="#F97316"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#C2410C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5,8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </Window.Resources>

    <Border Margin="12"
            Padding="12"
            BorderBrush="#F97316"
            BorderThickness="2"
            CornerRadius="12"
            Background="#FFFDFC">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- APPLICATION HEADER -->
            <Border Grid.Row="0"
                    Background="#B9380A"
                    CornerRadius="9"
                    Padding="16"
                    Margin="0,0,0,12">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="7"
                            Padding="10"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">

                        <Image Source="/CyberSafeAwarenessBot2;component/CyberSafeASCII.png"
                               Width="64"
                               Height="64"
                               Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <TextBlock Text="CYBERSAFE AWARENESS BOT"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Your guide to staying safe online"
                                   FontSize="14"
                                   Foreground="#FFE4D6"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="Ask questions. Learn the risks. Stay protected."
                                   FontSize="12"
                                   Foreground="White"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN NAVIGATION -->
            <TabControl x:Name="MainTabControl"
                        Grid.Row="1"
                        FontSize="14"
                        Background="White"
                        BorderBrush="#FED7AA"
                        BorderThickness="1">

                <!-- CHAT -->
                <TabItem Header="Chat">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="White"
                                BorderBrush="#FED7AA"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,12">

                            <TextBox x:Name="ChatHistory"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     BorderThickness="0"
                                     Background="White"
                                     Foreground="#334155"
                                     FontSize="14"
                                     FontFamily="Segoe UI"
                                     IsTabStop="False"
                                     Text="Bot: Welcome to CyberSafe Awareness Bot!&#10;Bot: Ask me about passwords, phishing, scams, or online privacy."/>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="UserInput"
                                     Grid.Column="0"
                                     MinHeight="42"
                                     Padding="10"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,10,0"
                                     ToolTip="Type your cybersecurity question"/>

                            <Button x:Name="SendButton"
                                    Grid.Column="1"
                                    Content="Send"
                                    Width="100"
                                    MinHeight="42"
                                    Margin="0"
                                    Click="SendButton_Click"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TASK ASSISTANT -->
                <TabItem Header="Tasks">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Cybersecurity Task Assistant"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#B9380A"
                                   Margin="0,0,0,15"/>

                        <StackPanel Grid.Row="1"
                                    Margin="0,0,0,15">

                            <TextBlock Text="Task title"/>
                            <TextBox x:Name="TaskTitleInput"
                                     Height="34"
                                     Margin="0,5,0,10"/>

                            <TextBlock Text="Description"/>
                            <TextBox x:Name="TaskDescriptionInput"
                                     Height="55"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Margin="0,5,0,10"/>

                            <TextBlock Text="Optional reminder"/>
                            <DatePicker x:Name="TaskReminderInput"
                                        Height="32"
                                        Margin="0,5,0,10"/>

                            <Button Content="Add Task"
                                    Width="110"
                                    Height="36"
                                    HorizontalAlignment="Left"
                                    Margin="0,5,0,0"
                                    Click="AddTask_Click"/>
                        </StackPanel>

                        <DataGrid x:Name="TasksGrid"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Margin="0,5"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="32">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding TaskId}"
                                                    Width="55"/>

                                <DataGridTextColumn Header="Title"
                                                    Binding="{Binding Title}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Description"
                                                    Binding="{Binding Description}"
                                                    Width="2*"/>

                                <DataGridTextColumn Header="Reminder"
                                                    Binding="{Binding ReminderDate}"
                                                    Width="150"/>

                                <DataGridCheckBoxColumn Header="Completed"
                                                        Binding="{Binding IsCompleted}"
                                                        Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0">

                            <Button Content="Refresh"
                                    Width="90"
                                    Click="RefreshTasks_Click"/>

                            <Button Content="Complete"
                                    Width="90"
                                    Click="CompleteTask_Click"/>

                            <Button Content="Delete"
                                    Width="90"
                                    Click="DeleteTask_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- CYBER QUIZ -->
                <TabItem Header="Cyber Quiz">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Cybersecurity Knowledge Quiz"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#B9380A"/>

                            <TextBlock x:Name="QuizProgressText"
                                       Text="Question 1 of 12"
                                       FontSize="14"
                                       Foreground="#64748B"
                                       Margin="0,8,0,15"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="#FFF7ED"
                                BorderBrush="#FED7AA"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18"
                                Margin="0,0,0,15">

                            <TextBlock x:Name="QuizQuestionText"
                                       Text="Your question will appear here."
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="#334155"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <StackPanel x:Name="QuizOptionsPanel"
                                        Margin="5,8"
                                        HorizontalAlignment="Stretch"/>
                        </ScrollViewer>

                        <Border Grid.Row="3"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,10">

                            <TextBlock x:Name="QuizFeedbackText"
                                       Text="Select an answer and submit."
                                       TextWrapping="Wrap"
                                       Foreground="#334155"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="QuizScoreText"
                                       Grid.Column="0"
                                       Text="Score: 0"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="#B9380A"/>

                            <Button x:Name="SubmitAnswerButton"
                                    Grid.Column="1"
                                    Content="Submit Answer"
                                    MinWidth="125"
                                    Margin="5"
                                    Click="SubmitAnswer_Click"/>

                            <Button x:Name="NextQuestionButton"
                                    Grid.Column="2"
                                    Content="Next"
                                    MinWidth="85"
                                    Margin="5"
                                    IsEnabled="False"
                                    Click="NextQuestion_Click"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ACTIVITY LOG -->
                <TabItem Header="Activity Log">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Recent Activity"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#B9380A"/>

                            <TextBlock Text="Your recent chatbot and task activities."
                                       Margin="0,8,0,15"
                                       Foreground="#64748B"/>
                        </StackPanel>

                        <ListBox x:Name="ActivityLogList"
                                 Grid.Row="1"
                                 FontSize="14"
                                 Padding="10"
                                 BorderBrush="#FED7AA"
                                 Background="White"/>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</Window>
