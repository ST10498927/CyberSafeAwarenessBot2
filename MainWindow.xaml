<Window x:Class="CyberSafeAwarenessBot2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberSafe Awareness Bot"
        Height="600"
        Width="800"
        MinHeight="500"
        MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7ED">

    <Border BorderBrush="#F97316"
            BorderThickness="3"
            CornerRadius="12"
            Margin="12"
            Padding="12"
            Background="#FFF7ED">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="#C2410C"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,15">

                <StackPanel>
                    <TextBlock Text="CYBERSAFE AWARENESS BOT"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="White"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Your guide to staying safe online"
                               FontSize="14"
                               Foreground="#FFEDD5"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Chat history -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#FED7AA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,15">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ChatHistory"
                               Text="Bot: Welcome to CyberSafe Awareness Bot!&#10;Bot: Ask me about passwords, phishing, scams, or online privacy."
                               FontSize="15"
                               TextWrapping="Wrap"
                               Foreground="#333333"
                               LineHeight="24"/>
                </ScrollViewer>
            </Border>

            <!-- Message input -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInput"
                         Grid.Column="0"
                         Height="44"
                         FontSize="15"
                         Padding="10"
                         VerticalContentAlignment="Center"
                         BorderBrush="#FDBA74"
                         BorderThickness="1"
                         Margin="0,0,10,0"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send"
                        Height="44"
                        FontSize="15"
                        FontWeight="Bold"
                        Background="#F97316"
                        Foreground="White"
                        BorderBrush="#C2410C"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="SendButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
