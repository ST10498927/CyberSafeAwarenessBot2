<Window x:Class="CyberSafeAwarenessBot2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberSafe Awareness Bot"
        Height="650"
        Width="850"
        MinHeight="500"
        MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Border Margin="12"
            Padding="12"
            BorderBrush="#F97316"
            BorderThickness="2"
            CornerRadius="12"
            Background="#FFFDFC">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header and ASCII logo -->
            <Border Grid.Row="0"
                    Background="#B9380A"
                    CornerRadius="9"
                    Padding="16"
                    Margin="0,0,0,12">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#FFFFFF"
                            CornerRadius="7"
                            Padding="10"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">

                        <TextBlock FontFamily="Consolas"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#B9380A"
                                   TextAlignment="Center"
                                   xml:space="preserve">  /\
 /  \
/ /\ \
| || |
| || |
\____/
 STAY SAFE</TextBlock>
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <TextBlock Text="CYBERSAFE AWARENESS BOT"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Your guide to staying safe online"
                                   FontSize="14"
                                   Foreground="#FFE4D6"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="Ask questions. Learn the risks. Stay protected."
                                   FontSize="12"
                                   Foreground="White"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chat history -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#FED7AA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12">

                <TextBox x:Name="ChatHistory"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0"
                         Background="White"
                         Foreground="#334155"
                         FontSize="14"
                         FontFamily="Segoe UI"
                         IsTabStop="False"
                         Text="Bot: Welcome to CyberSafe Awareness Bot!&#10;Bot: Ask me about passwords, phishing, scams, or online privacy."/>
            </Border>

            <!-- Message input and Send button -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInput"
                         Grid.Column="0"
                         MinHeight="42"
                         Padding="10"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         BorderBrush="#94A3B8"
                         BorderThickness="1"
                         Margin="0,0,10,0"
                         ToolTip="Type your cybersecurity question"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send"
                        Width="100"
                        MinHeight="42"
                        Padding="12,8"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#F97316"
                        BorderBrush="#C2410C"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="SendButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
